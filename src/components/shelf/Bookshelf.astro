---
// 3D bookshelf, adapted from petargyurov/virtual-bookshelf (The Unlicense —
// public domain). Kept from the original: the three-face box (spine / top /
// cover), the rotate-out-on-hover transform, and the vertical spine lettering.
// Changed for this site: squared corners instead of rounded, the frame's violet
// ink instead of the demo's loud CSS patterns, the covers use the banner drape,
// and each book is a link to its own entry.
interface Book {
  id: string
  title: string
  author?: string
  favorite?: boolean
  /** Cover art path. Falls back to the drape when absent. */
  cover?: string
}

interface Props {
  books: Book[]
}

const { books } = Astro.props

// Four ink tints so neighbouring spines are distinguishable without leaving the
// palette. Assigned by position, so the shelf looks the same on every build.
const tints = ['a', 'b', 'c', 'd']
---

<div class="shelf-unit">
  <ol class="bookshelf">
    {
      books.map((book, i) => (
        <li>
          <a class="book" href={`/shelf/${book.id}`} data-tint={tints[i % tints.length]}>
            <span class="side spine">
              <span class="spine-title">{book.title}</span>
              {book.author && <span class="spine-author">{book.author}</span>}
            </span>
            <span class="side top" aria-hidden="true"></span>
            <span
              class:list={['side', 'cover', { 'cover--art': !!book.cover }]}
              aria-hidden="true"
              style={book.cover ? `background-image: url('${book.cover}')` : undefined}
            >
              {!book.cover && <span class="cover-title">{book.title}</span>}
            </span>
          </a>
        </li>
      ))
    }
  </ol>
  <div class="shelf-board" aria-hidden="true"></div>
</div>

<style>
  .shelf-unit {
    margin: 0 0 1.75rem;
    perspective: 1400px;
  }

  .bookshelf {
    list-style: none;
    margin: 0;
    padding: 0 0.5rem;
    display: flex;
    align-items: flex-end;
    gap: 6px;
    min-height: 250px;
  }

  .book {
    display: block;
    width: 46px;
    height: 240px;
    position: relative;
    transform-style: preserve-3d;
    transform-origin: bottom left;
    transform: translateZ(0) rotateY(0);
    transition: transform 700ms var(--ease-elegant);
    text-decoration: none;
  }

  .side {
    position: absolute;
    border: 1px solid var(--ink-invert);
    box-sizing: border-box;
    transform-origin: center left;
  }

  .spine {
    width: 46px;
    height: 240px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0.2rem;
    transform: rotateY(0deg) translateZ(0);
    overflow: hidden;
  }

  /* Vertical lettering, as on a real spine. */
  .spine-title,
  .spine-author {
    writing-mode: vertical-rl;
    font-family: var(--mono);
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .spine-title {
    font-size: 0.68rem;
    font-weight: 700;
    max-height: 170px;
  }

  .spine-author {
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.75;
    max-height: 56px;
  }

  /* Page block seen from above. */
  .top {
    width: 46px;
    height: 160px;
    top: -1px;
    background-image: repeating-linear-gradient(
      90deg,
      var(--paper) 0 3px,
      rgba(42, 36, 32, 0.35) 3px 4px
    );
    transform: rotateX(90deg) translateZ(80px) translateY(-80px);
  }

  .cover {
    width: 160px;
    height: 240px;
    top: 0;
    left: 46px;
    background-color: var(--drape-dark);
    background-image:
      radial-gradient(circle at center, var(--drape-deep) 0.8px, transparent 1px),
      url('/images/banner-drape.webp');
    background-size: 4px 4px, cover;
    background-position: 0 0, center;
    transform: rotateY(90deg) translateZ(0);
    display: flex;
    align-items: flex-end;
    padding: 0.7rem;
  }

  /* With real cover art there is a single background layer, so the two-layer
     size/position from .cover would tile it at 4px. Reset both. */
  .cover--art {
    background-size: cover;
    background-position: center;
  }

  .cover-title {
    font-family: var(--display);
    font-size: 1.05rem;
    line-height: 1.15;
    color: var(--on-drape);
    text-shadow: 0 1px 8px rgba(30, 22, 48, 0.6);
  }

  /* Spine tints — all four are the same violet, at four densities. */
  .book[data-tint='a'] .spine {
    background: #4B3754;
    color: #f1ede4;
  }
  .book[data-tint='b'] .spine {
    background: #5a4f72;
    color: #f1ede4;
  }
  .book[data-tint='c'] .spine {
    background: #877b96;
    color: #211b2c;
  }
  .book[data-tint='d'] .spine {
    background: #b3aabd;
    color: #211b2c;
  }

  @media (hover: hover) and (pointer: fine) {
    .book:hover,
    .book:focus-visible {
      z-index: 1;
      transform: rotateX(-18deg) rotateY(-38deg) rotateZ(-10deg) translateY(24px)
        translateX(-18px);
    }
  }

  /* The board the books stand on. */
  .shelf-board {
    height: 10px;
    border: 1px solid var(--rule);
    border-top-width: 2px;
    background: repeating-linear-gradient(
      90deg,
      rgba(42, 36, 32, 0.1) 0 6px,
      transparent 6px 12px
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .book {
      transition: none;
    }
  }

  @media (max-width: 560px) {
    .bookshelf {
      gap: 4px;
    }

    .book,
    .spine {
      height: 190px;
    }

    .spine-title {
      max-height: 130px;
    }

    .top {
      transform: rotateX(90deg) translateZ(80px) translateY(-80px);
    }

    .cover {
      height: 190px;
    }
  }
</style>
