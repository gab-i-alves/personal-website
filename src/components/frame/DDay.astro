---
// The next hard date, counted down. Sits under the calendar: the calendar says
// what day it is, this says how much of it is left.
//
// The number is computed in the browser. A static build would freeze the count
// at deploy time and quietly lie a week later.
import { nextDeadline } from '@/data/deadlines'

const due = nextDeadline()
const [y, m, d] = due ? due.iso.split('-') : ['', '', '']
---

{
  due && (
    <div class="dday">
      <div class="dday-count">
        <span class="dday-d" aria-hidden="true">
          D-
        </span>
        <span class="dday-n" data-dday={due.iso}>
          ··
        </span>
      </div>

      <p class="dday-label">{due.href ? <a href={due.href}>{due.label}</a> : due.label}</p>

      <p class="dday-date">
        <time datetime={due.iso}>
          {d}.{m}.{y}
        </time>
        {due.note && <span class="dday-note">{due.note}</span>}
      </p>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-dday]').forEach((el) => {
    const due = new Date(`${el.dataset.dday}T23:59:59`)
    const days = Math.ceil((due.getTime() - Date.now()) / 86_400_000)
    el.textContent = days > 0 ? String(days) : days === 0 ? '0' : '—'
    if (days <= 7) el.closest('.dday')?.classList.add('is-close')
    if (days < 0) el.closest('.dday')?.classList.add('is-past')
  })
</script>

<style>
  .dday {
    text-align: center;
    padding: 0.5rem 0.4rem 0.55rem;
  }

  /* "D-32" reads as one token, so it's set as one: same size, same weight. */
  .dday-count {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0;
    font-family: var(--mono);
    font-feature-settings: var(--mono-feat);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text);
    line-height: 1.1;
  }

  .dday-d,
  .dday-n {
    font-size: inherit;
    font-weight: inherit;
  }

  .dday-label {
    margin: 0.35rem 0 0;
    font-size: 0.74rem;
    line-height: 1.3;
    color: var(--text-dim);
  }

  .dday-label a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }

  @media (hover: hover) and (pointer: fine) {
    .dday-label a:hover {
      color: var(--text);
    }
  }

  .dday-date {
    margin: 0.2rem 0 0;
    font-family: var(--mono);
    font-feature-settings: var(--mono-feat);
    font-size: 0.6rem;
    color: var(--text-faint);
    letter-spacing: 0.06em;
  }

  .dday-note::before {
    content: '·';
    margin: 0 0.3rem;
    opacity: 0.5;
  }

  /* Inside a week the number stops being ambient information. */
  .dday.is-close .dday-n {
    background: var(--ink-invert);
    color: var(--ink-invert-text);
    padding: 0 0.25rem;
  }

  .dday.is-past .dday-n {
    opacity: 0.4;
  }
</style>
