---
// Grouped link list shared by both rails. An item without an `href` renders as
// a dotted placeholder rather than a dead link.
export interface GroupItem {
  label: string
  href?: string
  note?: string
}

interface Props {
  groups: { label: string; items: GroupItem[] }[]
}

const { groups } = Astro.props
const shown = groups.filter((group) => group.items.length > 0)
---

<div class="groups">
  {
    shown.map((group) => (
      <section>
        <h3 class="group-label">{group.label}</h3>
        <ul class="group-list">
          {group.items.map((item) => (
            <li>
              <span class="glyph" aria-hidden="true">{item.href ? '›' : '·'}</span>
              <span class="entry">
                {item.href ? (
                  <a href={item.href}>{item.label}</a>
                ) : (
                  <span class="pending" title="not set up yet">
                    {item.label}
                  </span>
                )}
                {item.note && <span class="note">{item.note}</span>}
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  <slot />
</div>

<style>
  .groups {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .group-label {
    font-family: var(--mono);
    font-size: 0.58rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.15rem;
    margin: 0 0 0.25rem;
  }

  .group-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .group-list li {
    display: flex;
    gap: 0.35rem;
    align-items: baseline;
    padding: 0.1rem 0;
  }

  .glyph {
    flex: 0 0 auto;
    color: var(--text-faint);
  }

  .entry {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .entry a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  @media (hover: hover) and (pointer: fine) {
    .entry a:hover {
      background: var(--mark);
    }
  }

  /* Reads as a slot waiting to be filled, not a broken link. */
  .pending {
    color: var(--text-faint);
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 0.18em;
    cursor: default;
  }

  .note {
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
</style>
