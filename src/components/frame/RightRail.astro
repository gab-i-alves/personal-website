---
import Widget from '@/components/frame/Widget.astro'
import LinkGroups from '@/components/frame/LinkGroups.astro'
import { getCollection } from 'astro:content'
import { currently, findMe } from '@/data/now'
import { lastChange } from '@/data/changelog'
import { getSortedFilteredPosts } from '@/utils/draft'
import { formatDate } from '@/utils/date'

const posts = await getSortedFilteredPosts()
const latestPost = posts[0]

const logs = (await getCollection('dailyLogs'))
  .filter((log) => !log.id.startsWith('_'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
const latestLog = logs[0]

// "last touched" is the newest date across the content collections and the
// changelog — real data, so the bar never claims an update that did not
// happen. The changelog is in there because shipping a page counts as touching
// the site just as much as posting does.
const dates = [latestPost?.data.pubDate, latestLog?.data.date, lastChange].filter(Boolean) as Date[]
const lastTouched = dates.length ? new Date(Math.max(...dates.map((d) => d.valueOf()))) : null
const lastTouchedLabel = lastTouched ? formatDate(lastTouched) : '—'
---

<Widget title="gabi alves" bare>
  <div class="card">
    <div class="portrait-frame">
      <img class="portrait" src="/images/avatar.webp" alt="gabi alves" width="400" height="400" />
      {/* stuck on the bottom-left corner, over the ornament */}
      <img
        class="portrait-pin"
        src="/images/pfp-icon.gif"
        alt=""
        role="presentation"
        width="18"
        height="18"
      />
    </div>
    <p class="ident">trying my best</p>
  </div>
  <div class="bar-invert">
    <span>last touched</span>
    <span>{lastTouchedLabel}</span>
  </div>
</Widget>

<Widget title="what am i doing?">
  <ul class="rail-list">
    {
      currently.map((item) => (
        <li>
          <span class="glyph" aria-hidden="true">{item.glyph}</span>
          <span class="entry">
            <span class="entry-label">{item.label}</span>
            <span class="entry-value">{item.value}</span>
          </span>
        </li>
      ))
    }
  </ul>
</Widget>

<Widget title="latest">
  <div class="rail-stack">
    {
      latestPost && (
        <a class="latest" href={`/${latestPost.id}`}>
          <span class="kind">article</span>
          <span class="what">{latestPost.data.title}</span>
        </a>
      )
    }
    {
      latestLog && (
        <a class="latest" href={`/daily-logs/${latestLog.id}`}>
          <span class="kind">daily log</span>
          <span class="what">{latestLog.id}</span>
        </a>
      )
    }
  </div>
</Widget>

<Widget title="find me">
  <LinkGroups groups={findMe} />
</Widget>

<style>
  .card {
    padding: 0.5rem 0.5rem 0.45rem;
  }

  /* The ornate frame is an overlay, so the portrait is inset far enough that the
     filigree sits over the edges of the picture instead of cropping it. */
  /* No ornament layer any more: the portrait runs edge to edge, so the padding
     that used to make room for the frame art goes with it. */
  .portrait-frame {
    position: relative;
    line-height: 0;
  }

  .portrait {
    display: block;
    width: 100%;
    height: auto;
  }

  /* 36px is 2x the source exactly — doubling keeps every pixel square, where
     an in-between size would smear the art even with pixelated rendering. */
  .portrait-pin {
    position: absolute;
    /* Pinned to the bottom-left corner itself, overhanging the edge. */
    bottom: -9px;
    left: -9px;
    z-index: 2;
    width: 36px;
    height: 36px;
    image-rendering: pixelated;
    pointer-events: none;
    filter: drop-shadow(0 1px 2px rgba(20, 14, 32, 0.5));
  }

  .ident {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.02em;
    color: var(--text-dim);
    text-align: center;
    margin: 0.4rem 0 0;
  }

  .entry {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .entry-label {
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .entry-value {
    font-size: 0.68rem;
    line-height: 1.45;
    color: var(--text);
  }

  .latest {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--text);
    border: 1px solid var(--border);
    padding: 0.3rem 0.4rem;
  }

  .latest:hover {
    background: var(--mark);
  }

  .kind {
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .what {
    font-size: 0.68rem;
    line-height: 1.4;
  }
</style>
