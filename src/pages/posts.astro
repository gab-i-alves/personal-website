---
import FrameLayout from '@/layouts/FrameLayout.astro'
import FormattedDate from '@/components/widgets/FormattedDate.astro'
import { themeConfig } from '@/config'
import { getSortedFilteredPosts } from '@/utils/draft'

const posts = await getSortedFilteredPosts()
---

<FrameLayout
  title={`Articles · ${themeConfig.site.title}`}
  description={themeConfig.site.description}
  variant="page"
  current="/posts"
  section={{ label: 'articles', href: '/posts' }}
  epigraph="one thought per page, finished"
  heading="articles"
>
  <div class="toc-wrapper">

    <ol class="frows">
      {posts.map((post, i) => (
        <li>
          <a href={`/${post.id}`} class="frow">
            <span class="frow-gutter">
              <span class="strong">{String(i + 1).padStart(2, '0')}</span>
              <span><FormattedDate date={post.data.pubDate} context="list" /></span>
              {post.data.tags?.length > 0 && <span class="faint">{post.data.tags[0]}</span>}
            </span>
            <span class="frow-main">
              <span class="frow-title">{post.data.title}</span>
              {post.data.description && <p class="frow-body">{post.data.description}</p>}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</FrameLayout>

<style is:global>
  .toc-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }
</style>
