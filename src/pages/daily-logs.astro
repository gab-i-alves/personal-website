---
import FrameLayout from '@/layouts/FrameLayout.astro'
import CalendarView from '@/components/daily-logs/CalendarView.astro'
import { themeConfig } from '@/config'
import { getCollection, render } from 'astro:content'
import { experimental_AstroContainer as AstroContainer } from 'astro/container'

const container = await AstroContainer.create()

const allLogs = await getCollection('dailyLogs')
const sortedLogs = allLogs
  .filter((log) => !log.id.startsWith('_'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const logsWithBody = await Promise.all(sortedLogs.map(async (log) => {
  const d = log.data.date
  const { Content } = await render(log)
  const html = await container.renderToString(Content)
  return {
    slug: log.id,
    year: d.getUTCFullYear(),
    month: d.getUTCMonth(),
    day: d.getUTCDate(),
    mood: log.data.mood || '',
    tags: log.data.tags || [],
    photo: log.data.photo || '',
    body: html
  }
}))
---

<FrameLayout
  title={`Daily Log · ${themeConfig.site.title}`}
  description="Daily accountability logs"
  variant="page"
  current="/daily-logs"
  section={{ label: 'logs', href: '/daily-logs' }}
  epigraph="the unfinished half"
  heading="daily logs"
>
  <div class="dailylogs-page">

    <CalendarView logs={logsWithBody} />
  </div>
</FrameLayout>

<style is:global>
  .dailylogs-header {
    padding: 0 0 1.5rem;
    text-align: center;
  }

  /* --- CalendarView, pulled into the frame's grammar --------------------
     The component keeps its behaviour (month nav, photo cells, the panel that
     opens on click); only its surfaces change: squared cells, 1px rules,
     everything in the mono face, day numbers as numerals instead of display
     glyphs. Overrides live here rather than in the component so the component
     stays reusable outside the frame. */
  /* Month header as one inverted bar across the full width, the way a printed
     wall calendar does it — the nav buttons sit inside the bar. */
  .dailylogs-page .cal-nav {
    gap: 0.75rem;
    margin-bottom: 0;
    background: var(--ink-invert);
    color: var(--ink-invert-text);
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--ink-invert);
  }

  .dailylogs-page .cal-nav-btn,
  .dailylogs-page .cal-month,
  .dailylogs-page .cal-year,
  .dailylogs-page .cal-today-btn {
    color: var(--ink-invert-text);
  }

  .dailylogs-page .cal-nav-btn,
  .dailylogs-page .cal-today-btn {
    border-color: rgba(245, 240, 232, 0.4);
    background: transparent;
  }

  .dailylogs-page .cal-nav-btn {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0;
    opacity: 1;
  }

  .dailylogs-page .cal-month-label {
    min-width: 10rem;
    gap: 0.4rem;
  }

  .dailylogs-page .cal-month {
    font-family: var(--mono);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: lowercase;
    opacity: 1;
  }

  .dailylogs-page .cal-year {
    font-size: 0.82rem;
    font-weight: 700;
    /* On the inverted bar, so it has to be light like the rest of it. */
    color: var(--ink-invert-text);
    opacity: 0.7;
  }

  .dailylogs-page .cal-today-btn {
    font-family: var(--mono);
    border-radius: 0;
    font-size: 0.62rem;
    padding: 0.1rem 0.5rem;
  }

  .dailylogs-page .cal-weekdays {
    gap: 0;
    margin-bottom: 0;
    border-top: 1px dotted var(--rule);
  }

  .dailylogs-page .cal-weekdays span {
    font-family: var(--mono);
    font-size: 0.6rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 1;
    color: var(--text-dim);
    padding: 0.25rem 0;
    border-right: 1px dotted var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .dailylogs-page .cal-weekdays span:first-child {
    border-left: 1px dotted var(--rule);
  }

  .dailylogs-page .cal-grid {
    gap: 0;
  }

  .dailylogs-page .cal-cell {
    border-radius: 0;
    border: none;
    border-right: 1px dotted var(--rule);
    border-bottom: 1px dotted var(--rule);
    aspect-ratio: 1.35;
    animation: none;
  }

  .dailylogs-page .cal-grid > .cal-cell:nth-child(7n + 1) {
    border-left: 1px dotted var(--rule);
  }

  .dailylogs-page .cal-cell--empty {
    background: repeating-linear-gradient(
      -45deg,
      transparent 0 5px,
      rgba(42, 36, 32, 0.06) 5px 6px
    );
  }

  .dailylogs-page .cal-cell--log {
    background: rgba(42, 36, 32, 0.05);
  }

  .dailylogs-page .cal-cell--today {
    border: 1px solid var(--ink-invert);
  }

  .dailylogs-page .cal-day {
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 400;
    top: 0.25rem;
    left: 0.35rem;
    opacity: 0.55;
    font-variant-numeric: tabular-nums;
  }

  .dailylogs-page .cal-cell--log .cal-day {
    font-weight: 700;
    opacity: 1;
  }
</style>
