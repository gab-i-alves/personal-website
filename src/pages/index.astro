---
import FrameLayout from '@/layouts/FrameLayout.astro'
import { themeConfig } from '@/config'
import { formatDate } from '@/utils/date'
import { getCollection } from 'astro:content'
import { getSortedFilteredPosts } from '@/utils/draft'

// The changelog in the centre column is derived from real content dates, so it
// can never drift out of sync with what is actually published.
const posts = await getSortedFilteredPosts()
const logs = (await getCollection('dailyLogs'))
  .filter((log) => !log.id.startsWith('_'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

type Entry = { date: Date; kind: string; label: string; href: string }

const entries: Entry[] = [
  ...posts.map((post) => ({
    date: post.data.pubDate,
    kind: 'new article',
    label: post.data.title,
    href: `/${post.id}`
  })),
  ...logs.map((log) => ({
    date: log.data.date,
    kind: 'daily log',
    label: log.id,
    href: `/daily-logs/${log.id}`
  }))
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 8)

const fmt = (d: Date) => formatDate(d)
---

<FrameLayout
  title={themeConfig.site.title}
  description={themeConfig.site.description}
  chrome="portal"
  variant="portal"
  current="/"
>
  <div class="frame-prose">
    <p>
      welcome to my space. this is a digital garden i'm taking better care of from now on — the
      plan is something new here every week.
    </p>
    <p>
      the <a href="/daily-logs">daily log</a> is the main focus right now, because i use it for
      accountability while i finish my post-grad thesis. that means the
      <a href="/posts">articles</a> come out less often than i'd like. the
      <a href="/shelf">shelf</a> holds notes on whatever i've been reading, and the rails on either
      side change more often than the pages do.
    </p>
    <p>
      posts are in english or portuguese, depending on the topic — i don't translate them. i work in
      data engineering, so a lot of what shows up here is systems, pipelines and the books that
      keep changing how i think about them.
    </p>
  </div>

  {/* The sparkles are white, so they only read over the dark drape band. */}
  <div class="frame-strip strip-sparkle" aria-hidden="true"></div>

  <h2 class="frame-h1">changelog</h2>
  <p class="frame-ornament" aria-hidden="true">&#9670;</p>

  {
    entries.length > 0 ? (
      <ul class="frame-log">
        {entries.map((entry) => (
          <li>
            <span class="log-date">{fmt(entry.date)}</span> &ndash; {entry.kind}:{' '}
            <a href={entry.href}>{entry.label}</a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="frame-sub">nothing published yet.</p>
    )
  }

  <div class="frame-strip strip-sparkle" aria-hidden="true"></div>

  <p class="video-label">video recommendation...</p>

  <div class="video">
    <iframe
      src="https://www.youtube.com/embed/i8BLIhLNBpo"
      title="YouTube video player"
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen></iframe>
  </div>
</FrameLayout>

<style>
  .video-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text);
    margin: 0 0 0.5rem;
  }

  /* 16:9, squared off, with the frame's 1px rule instead of the default border. */
  .video {
    aspect-ratio: 16 / 9;
    border: 1px solid var(--rule);
    margin: 0.25rem 0 0;
    background: var(--ink-invert);
  }

  .video iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
