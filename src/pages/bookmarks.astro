---
import FrameLayout from '@/layouts/FrameLayout.astro'
import ScrapbookGrid from '@/components/bookmarks/ScrapbookGrid.astro'
import { categories } from '@/data/bookmarks'
import { themeConfig } from '@/config'
---

<FrameLayout
  title={`Bookmarks · ${themeConfig.site.title}`}
  description={themeConfig.site.description}
  variant="page"
  current="/bookmarks"
  section={{ label: 'bookmarks', href: '/bookmarks' }}
  epigraph="other people's good pages"
  heading="bookmarks"
>

  <ScrapbookGrid categories={categories} />
</FrameLayout>

<style is:global>
  .page-header {
    text-align: center;
    padding: 0 0 1.5rem;
  }
</style>
