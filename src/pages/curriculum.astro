---
import FrameLayout from '@/layouts/FrameLayout.astro'
import LoanCard from '@/components/study/LoanCard.astro'
import { getCollection } from 'astro:content'
import { themeConfig } from '@/config'

// Only the formal course is published here. The self-directed programme lives
// in the repo and is deliberately kept off the site.
//
// The page is built around one object, the way /shelf is built around the
// bookshelf: the loan card from the back of a library book. One card per
// subject, one row per lesson, a stamp for every step of the method that got
// done. Below it, the catalogue drawer — all eight subjects as index cards.

const LESSONS_PER_SUBJECT = 8
const STEPS_PER_LESSON = 4

const mba = (await getCollection('mba')).sort((a, b) => a.data.order - b.data.order)

const subjects = mba.map((entry) => {
  const lessons = entry.data.lessons
  const stamped = lessons.reduce(
    (acc, l) => acc + [l.pre, l.deep, l.live, l.artifact].filter(Boolean).length,
    0
  )
  return {
    entry,
    lessons,
    stamped,
    capacity: Math.max(lessons.length, LESSONS_PER_SUBJECT) * STEPS_PER_LESSON
  }
})

const yearStamped = subjects.reduce((a, s) => a + s.stamped, 0)
const yearCapacity = subjects.reduce((a, s) => a + s.capacity, 0)
const running = subjects.filter((s) => s.entry.data.status === 'active')

const STATUS_LABEL = { planned: 'a abrir', active: 'em curso', done: 'devolvida' } as const

// There are no subject pages: this page is the whole control panel. The drawer
// links out to the study repo instead, and only for subjects that already have
// something in it — a link to an empty folder is worse than no link.
const REPO_BASE = 'https://github.com/gab-i-alves/pos-infnet/tree/main'

const description =
  'MBA em Engenharia de Dados — uma ficha por disciplina, uma marca por etapa concluída'
---

<FrameLayout
  title={`Study · ${themeConfig.site.title}`}
  description={description}
  variant="page"
  current="/curriculum"
  section={{ label: 'study', href: '/curriculum' }}
  epigraph="the receipts, not the promises"
  heading="study"
>
  <div class="study-page">
    {/* ===== the borrower's line ===== */}
    <div class="borrower">
      <span class="borrower-k">curso</span>
      <span class="borrower-v">mba em engenharia de dados · infnet</span>
      <span class="borrower-sep">·</span>
      <span class="borrower-k">prazo</span>
      <span class="borrower-v">jul 2026 – jul 2027</span>
      <span class="borrower-sep">·</span>
      <span class="borrower-k">marcas</span>
      <span class="borrower-v"><b>{yearStamped}</b>/{yearCapacity}</span>
    </div>

    {/* ===== the card currently out on loan ===== */}
    <section>
      <div class="cards">
        {
          running.map((s) => (
            <LoanCard code={s.entry.data.code} title={s.entry.data.title} lessons={s.lessons} />
          ))
        }
      </div>

      <p class="legend">
        uma linha por aula, uma coluna por etapa. <b>pre</b> a leitura que o professor passou ·
        <b>deep</b> o aprofundamento por conta · <b>live</b> a aula com perguntas preparadas ·
        <b>proof</b> a nota fiscal, o artefato que prova que aprendi. sem a quarta marca, as três primeiras
        não contam.
      </p>
    </section>

    {/* ===== the catalogue drawer ===== */}
    <section>
      <div class="rulehead">
        <h2>o fichário</h2>
        <span class="rulehead-rule"></span>
        <span class="rulehead-n">8 disciplinas</span>
      </div>

      <ul class="drawer">
        {
          subjects.map((s) => {
            const d = s.entry.data
            // only subjects with something in the repo get a link out
            const link = d.status !== 'planned' && d.repo ? `${REPO_BASE}/${d.repo}` : undefined
            const Tag = link ? 'a' : 'div'
            return (
              <li>
                <Tag class:list={['idx', `idx--${d.status}`]} href={link} rel={link && 'noopener'}>
                  <span class="idx-code">{d.code}</span>
                  <span class="idx-main">
                    <span class="idx-name">
                      {d.title}
                      {link && <span class="idx-out"> ↗</span>}
                    </span>
                    <span class="idx-stack">{d.stack.slice(0, 3).join(' · ')}</span>
                  </span>
                  <span class="idx-tally">
                    <b>{String(s.stamped).padStart(2, '0')}</b>/{s.capacity}
                  </span>
                  <span class="idx-state">{STATUS_LABEL[d.status]}</span>
                </Tag>
              </li>
            )
          })
        }
      </ul>

      <p class="drawer-foot">
        o caderno bruto de cada disciplina fica em
        <a href="https://github.com/gab-i-alves/pos-infnet" rel="noopener">gab-i-alves/pos-infnet</a
        >.
      </p>
    </section>
  </div>
</FrameLayout>

<script>
  // Countdown computed in the browser so a stale build can't lie about it.
  document.querySelectorAll<HTMLTimeElement>('time[data-countdown]').forEach((el) => {
    const iso = el.dataset.countdown!
    const days = Math.ceil((new Date(`${iso}T23:59:59`).getTime() - Date.now()) / 86_400_000)
    const [y, m, d] = iso.split('-')
    const stamp = `${d}.${m}.${y}`
    el.textContent =
      days > 1
        ? `${stamp} · ${days} dias`
        : days === 1
          ? `${stamp} · amanhã`
          : days === 0
            ? `${stamp} · hoje`
            : stamp
  })
</script>

<style is:global>
  .study-page {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    padding-bottom: 2rem;
  }

  /* ===== borrower's line ===== */
  .study-page .borrower {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    background: var(--ink-invert);
    color: var(--ink-invert-text);
    font-family: var(--mono);
    font-feature-settings: var(--mono-feat);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    padding: 0.32rem 0.7rem;
  }

  .study-page .borrower-k {
    opacity: 0.5;
    text-transform: uppercase;
    font-size: 0.56rem;
  }

  .study-page .borrower-v b {
    font-weight: 700;
  }

  .study-page .borrower-sep {
    opacity: 0.28;
    margin: 0 0.25rem;
  }

  /* ===== section rule ===== */
  .study-page .rulehead {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .study-page .rulehead h2 {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text);
  }

  .study-page .rulehead-rule {
    flex: 1;
    height: 1px;
    background: var(--rule);
    opacity: 0.55;
  }

  .study-page .rulehead-n {
    font-family: var(--mono);
    font-feature-settings: var(--mono-feat);
    font-size: 0.62rem;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .study-page .cards {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .study-page .legend {
    margin: 1.1rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px dotted var(--rule);
    font-size: 0.73rem;
    line-height: 1.65;
    color: var(--text-faint);
    max-width: 68ch;
  }

  .study-page .legend b {
    font-family: var(--mono);
    font-size: 0.69rem;
    font-weight: 700;
    color: var(--text-dim);
  }

  /* ===== the catalogue drawer =====
     Index cards standing in a drawer: each one a thin slab of stock with a
     rule under it, so the list reads as a stack seen edge-on. */
  .study-page .drawer {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--rule);
    background: var(--panel);
  }

  .study-page .idx {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) 4.5rem 5.5rem;
    gap: 0.75rem;
    align-items: center;
    padding: 0.5rem 0.7rem;
    text-decoration: none;
    color: var(--text);
    border-bottom: 1px solid rgba(42, 36, 32, 0.12);
  }

  .study-page .drawer li:last-child .idx {
    border-bottom: none;
  }

  /* The one that's out on loan gets the tab sticking up. */
  .study-page .idx--active {
    background: rgba(74, 62, 99, 0.07);
    box-shadow: inset 3px 0 0 var(--ink-invert);
  }

  @media (hover: hover) and (pointer: fine) {
    .study-page .idx:hover {
      background: rgba(42, 36, 32, 0.06);
    }
  }

  .study-page .idx-code {
    font-family: var(--mono);
    font-feature-settings: var(--mono-feat);
    font-size: 0.68rem;
    color: var(--text-faint);
  }

  .study-page .idx-main {
    min-width: 0;
  }

  .study-page .idx-name {
    display: block;
    font-size: 0.86rem;
    line-height: 1.25;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .study-page .idx-stack {
    display: block;
    font-family: var(--mono);
    font-size: 0.6rem;
    color: var(--text-faint);
    margin-top: 0.1rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .study-page .idx-tally {
    font-family: var(--mono);
    font-feature-settings: var(--mono-feat);
    font-size: 0.68rem;
    color: var(--text-faint);
    text-align: right;
  }

  .study-page .idx-tally b {
    color: var(--text);
    font-weight: 700;
  }

  .study-page .idx-out {
    font-size: 0.62rem;
    color: var(--text-faint);
  }

  .study-page .drawer-foot {
    margin: 0.7rem 0 0;
    font-size: 0.72rem;
    color: var(--text-faint);
  }

  .study-page .drawer-foot a {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--text-dim);
    margin-left: 0.25rem;
  }

  .study-page .idx-state {
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    text-align: right;
  }

  .study-page .idx--active .idx-state {
    color: var(--ink-invert-text);
    background: var(--ink-invert);
    padding: 0.12rem 0.3rem;
  }

  @media (max-width: 700px) {
    .study-page .idx {
      grid-template-columns: 1.8rem minmax(0, 1fr) 4rem;
    }

    .study-page .idx-state {
      display: none;
    }
  }
</style>
