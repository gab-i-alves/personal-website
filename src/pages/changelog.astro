---
import FrameLayout from '@/layouts/FrameLayout.astro'
import { changelog } from '@/data/changelog'
import { themeConfig } from '@/config'

const KIND = {
  add: '+',
  change: '~',
  remove: '−',
  fix: '!'
} as const

function stamp(iso: string) {
  const [y, m, d] = iso.split('-')
  return `${d}.${m}.${y}`
}

const total = changelog.reduce((a, e) => a + e.items.length, 0)
---

<FrameLayout
  title={`Changelog · ${themeConfig.site.title}`}
  description="what changed on this site, and when"
  variant="page"
  current="/changelog"
  section={{ label: 'changelog', href: '/changelog' }}
  epigraph="a site is never finished"
  heading="changelog"
>
  <div class="chlog">
    <p class="chlog-intro">
      o que mudou aqui, e quando. o topo desta lista é o que a barra <b>last touched</b> mostra no rail
      — se a data está velha, é porque nada foi feito mesmo.
    </p>

    <div class="chlog-count">{total} mudanças · {changelog.length} datas</div>

    {
      changelog.map((entry) => (
        <section class="chlog-entry">
          <h2 class="chlog-date">
            <time datetime={entry.date}>{stamp(entry.date)}</time>
          </h2>
          <ul class="chlog-items">
            {entry.items.map((item) => (
              <li class:list={[`k--${item.kind}`]}>
                <span class="chlog-kind" aria-label={item.kind}>
                  {KIND[item.kind]}
                </span>
                <span class="chlog-text">{item.text}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</FrameLayout>

<style is:global>
  .chlog {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 2rem;
  }

  .chlog-intro {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.65;
    color: var(--text-dim);
    max-width: 58ch;
  }

  .chlog-intro b {
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text);
  }

  .chlog-count {
    font-family: var(--mono);
    font-feature-settings: var(--mono-feat);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--rule);
  }

  /* Date on the left, entries to its right — the shape of a printed log. */
  .chlog-entry {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .chlog-date {
    margin: 0;
    font-family: var(--mono);
    font-feature-settings: var(--mono-feat);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text);
    padding-top: 0.15rem;
    position: sticky;
    top: 1rem;
  }

  .chlog-items {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--rule);
  }

  .chlog-items li {
    display: grid;
    grid-template-columns: 1.4rem minmax(0, 1fr);
    gap: 0.4rem;
    padding: 0.3rem 0 0.3rem 0.75rem;
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--text-dim);
  }

  /* The sign carries the meaning, so it gets the weight and the colour. */
  .chlog-kind {
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 700;
    text-align: center;
    color: var(--text-faint);
    line-height: 1.5;
  }

  .chlog-items .k--add .chlog-kind {
    color: var(--ink-invert);
  }

  .chlog-items .k--remove .chlog-text {
    color: var(--text-faint);
  }

  @media (max-width: 620px) {
    .chlog-entry {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.35rem;
    }

    .chlog-date {
      position: static;
    }
  }
</style>
